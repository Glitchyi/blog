---
import { getCollection } from 'astro:content';
import '../styles/global.css';

let posts = await getCollection('architectures');
posts = posts.filter(post => post.data.slug !== 'template');
posts.sort((a, b) => a.data.post - b.data.post);

const totalPosts = posts.length;
const totalChars = posts.reduce((acc, post) => acc + ((post.body || '').length), 0);
const namespaces = [...new Set(posts.map(p => p.data.namespace))].filter(Boolean);
const tiers = [...new Set(posts.map(p => p.data.tier))].filter(Boolean).sort((a,b)=>a-b);
const lastUpdated = posts.length > 0 
	? new Date(Math.max(...posts.map(p => new Date(p.data.date).getTime()))).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) 
	: 'Never';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link href="https://api.fontshare.com/v2/css?f[]=satoshi@900,700,500,300,400&display=swap" rel="stylesheet">
		<title>Architecture Blog</title>
	</head>
	<body class="bg-[#000005] text-zinc-100 antialiased min-h-screen" style="font-family: 'Satoshi', system-ui, sans-serif;">
		<main class="max-w-4xl mx-auto px-5 sm:px-6 md:px-10 py-8 md:py-10 border-x border-white/10 min-h-screen">
			<header class="mb-10 border-b border-white/10 pb-8">
				<div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[10px] font-mono text-zinc-600 mb-4 tracking-widest sm:tracking-[0.2em] uppercase font-bold">
					<span>SYS.STATS</span>
					<span class="text-zinc-800 hidden sm:inline">/</span>
					<span>{totalPosts} DEPLOYED</span>
					<span class="text-zinc-800 hidden sm:inline">/</span>
					<span>{totalChars.toLocaleString()} BYTES</span>
					<span class="text-zinc-800 hidden sm:inline">/</span>
					<span>LST.UPD: {lastUpdated}</span>
				</div>
				<h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-3">
					System Architecture <span class="text-white/20">Simulations</span>
				</h1>
				<p class="text-sm sm:text-base text-zinc-400 font-medium max-w-2xl leading-relaxed">
					Exploring foundational system architectures—dynamically deployed, stress-tested, and documented on a bare-metal Kubernetes cluster.
				</p>
			</header>
			
			<details class="group mb-8 rounded-md border border-white/10 bg-[#0d1117] overflow-hidden">
				<summary class="flex cursor-pointer items-center justify-between px-4 py-2 hover:bg-white/[0.02] transition-colors list-none select-none [&::-webkit-details-marker]:hidden">
					<div class="flex items-center gap-3">
						<span class="font-mono text-zinc-300 font-bold text-xs">Filter architectures</span>
						<span class="px-2 py-0.5 rounded-[4px] border border-white/10 text-[10px] text-zinc-400 bg-[#000005]">Collapsed</span>
					</div>
					<div class="flex items-center gap-1 text-xs text-zinc-500 hover:text-zinc-300 transition-colors">
						<svg class="w-3 h-3 group-open:hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
						<svg class="w-3 h-3 hidden group-open:block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" /></svg>
						<span class="group-open:hidden">Show filters</span>
						<span class="hidden group-open:inline">Hide filters</span>
					</div>
				</summary>
				<div class="border-t border-white/10 p-4 bg-[#000005]">
					<div class="flex flex-col sm:flex-row gap-4">
						<div class="flex flex-col gap-1.5 w-full sm:w-auto">
							<label class="text-[10px] font-mono uppercase text-zinc-500 tracking-wider">Namespace / Topic</label>
							<select id="filter-namespace" class="bg-[#0d1117] border border-white/10 rounded-md text-zinc-300 text-sm px-3 py-1.5 focus:border-white/20 focus:ring-1 focus:ring-white/20 outline-none cursor-pointer">
								<option value="all">Everything</option>
								{namespaces.map(ns => <option value={ns}>{ns}</option>)}
							</select>
						</div>
						<div class="flex flex-col gap-1.5 w-full sm:w-auto">
							<label class="text-[10px] font-mono uppercase text-zinc-500 tracking-wider">System Complexity</label>
							<select id="filter-tier" class="bg-[#0d1117] border border-white/10 rounded-md text-zinc-300 text-sm px-3 py-1.5 focus:border-white/20 focus:ring-1 focus:ring-white/20 outline-none cursor-pointer">
								<option value="all">All Tiers</option>
								{tiers.map(t => <option value={t}>Tier {t}</option>)}
							</select>
						</div>
						<div class="flex flex-col gap-1.5 w-full sm:w-auto">
							<div class="flex items-center gap-1.5">
								<label class="text-[10px] font-mono uppercase text-zinc-500 tracking-wider">AI Generated Posts</label>
								<div class="relative group/tip">
									<span id="ai-info-btn" class="text-[10px] font-mono text-zinc-600 border border-white/10 rounded-full w-3.5 h-3.5 flex items-center justify-center cursor-pointer hover:text-zinc-300 hover:border-white/20 transition-colors select-none">i</span>
									<div id="ai-info-tooltip" class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-64 px-3 py-2 rounded-lg bg-zinc-900 border border-white/10 text-zinc-300 text-[11px] leading-relaxed font-sans normal-case tracking-normal shadow-xl opacity-0 group-hover/tip:opacity-100 transition-opacity z-50 pointer-events-none">
										Some of these posts were written entirely using AI, because I was lazy and it honestly documents things I already know ᓚᘏᗢ
										<div class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-zinc-900"></div>
									</div>
								</div>
							</div>
							<button id="toggle-ai" data-active="true" class="flex items-center gap-2 px-3 py-1.5 rounded-md border text-sm font-mono cursor-pointer transition-all bg-emerald-950/50 border-emerald-500/30 text-emerald-400 hover:bg-emerald-950">
								<span class="w-1.5 h-1.5 rounded-full bg-emerald-400 inline-block"></span>
								Enabled
							</button>
						</div>
					</div>
				</div>
			</details>

			<div class="space-y-6" id="architectures-list">
				{posts.map(post => {
					const urlSlug = post.data.slug || post.id;
					const isAIPost = post.data.tags && post.data.tags.some((t: string) => t.toLowerCase() === 'ai');
					return (
					<article 
						class="post-card p-5 rounded-2xl border border-white/10 bg-white/[0.02] shadow-2xl shadow-black/60 flex flex-col relative transition-opacity duration-300"
						data-namespace={post.data.namespace || ''}
						data-tier={post.data.tier || ''}
						data-ai={isAIPost ? 'true' : 'false'}
					>
						<div class="absolute top-5 right-5 bg-zinc-800 text-zinc-200 font-bold px-2 py-0.5 rounded border border-white/20 text-[10px] uppercase tracking-widest shadow-sm">
							<span class="text-white/30 mr-0.5">#</span>{post.data.post}
						</div>
						<h2 class="text-lg sm:text-xl pr-12 font-bold mb-1">
							<a href={`/posts/${urlSlug}`} class="text-zinc-100 hover:text-white hover:underline decoration-white/30 underline-offset-4 transition-all">
								{post.data.title}
							</a>
						</h2>
						<div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-zinc-500 mb-3 font-mono">
							<span class="text-zinc-500">{post.data.date}</span>
							{post.data.tags && post.data.tags.length > 0 && <span class="hidden sm:inline opacity-50">•</span>}
							{post.data.tags && post.data.tags.map((tag: string) => {
								const isAI = tag.toLowerCase() === 'ai';
								return (
									<span class={`font-medium text-[10px] sm:ml-1 transition-all ${isAI ? 'text-emerald-400 bg-emerald-950/50 px-1.5 py-0.5 rounded-md border border-emerald-500/30 shadow-[0_0_10px_rgba(16,185,129,0.2)]' : 'text-indigo-400'}`}>
										#{tag}
									</span>
								);
							})}
						</div>
						<p class="text-zinc-300 text-sm mb-4 leading-relaxed bg-[#000005] p-3 rounded-xl border border-white/10 shadow-inner shadow-black/80">{post.data.description}</p>
						<a href={`/posts/${urlSlug}`} class="inline-flex items-center text-xs font-medium text-white hover:text-zinc-300 transition-colors mt-auto self-start">
							Read Simulation Log <span class="ml-1">→</span>
						</a>
					</article>
				)})}
				{posts.length === 0 && <p class="text-zinc-500 italic">No architectures found yet.</p>}
			</div>

			<footer class="mt-24 pt-8 border-t border-white/10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 text-xs text-zinc-500">
				<div>
					<p class="font-medium text-zinc-400 mb-1">
						Built by <a href="https://glitchy.systems/" target="_blank" class="text-white hover:underline decoration-white/30 underline-offset-4 transition-all">Advaith Narayanan (Glitchy)</a>
					</p>
					<p class="font-mono text-[10px] uppercase tracking-wider text-zinc-600">Software Developer @ IBM • Systems Programming • Cloud Engineering</p>
				</div>
				<div class="flex gap-4 font-mono uppercase tracking-wider text-[10px]">
					<a href="https://github.com/Glitchyi" target="_blank" class="hover:text-white transition-colors">GitHub</a>
					<a href="https://twitter.com/advaithnarayan" target="_blank" class="hover:text-white transition-colors">Twitter</a>
					<a href="https://glitchy.systems/" target="_blank" class="hover:text-white transition-colors">Portfolio</a>
				</div>
			</footer>
		</main>

		<script>
			const nsSelect = document.getElementById('filter-namespace');
			const tierSelect = document.getElementById('filter-tier');
			const aiToggle = document.getElementById('toggle-ai');
			const cards = document.querySelectorAll('.post-card');
			let showAI = true;

			function applyFilters() {
				const selectedNs = (nsSelect as HTMLSelectElement)?.value;
				const selectedTier = (tierSelect as HTMLSelectElement)?.value;

				cards.forEach(card => {
					const matchesNs = selectedNs === 'all' || card.getAttribute('data-namespace') === selectedNs;
					const matchesTier = selectedTier === 'all' || card.getAttribute('data-tier') === selectedTier;
					const cardIsAI = card.getAttribute('data-ai') === 'true';
					const matchesAI = showAI || !cardIsAI;

					if (matchesNs && matchesTier && matchesAI) {
						card.classList.remove('hidden');
						card.classList.add('flex');
					} else {
						card.classList.add('hidden');
						card.classList.remove('flex');
					}
				});
			}

			aiToggle?.addEventListener('click', () => {
				showAI = !showAI;
				if (showAI) {
					aiToggle.className = 'flex items-center gap-2 px-3 py-1.5 rounded-md border text-sm font-mono cursor-pointer transition-all bg-emerald-950/50 border-emerald-500/30 text-emerald-400 hover:bg-emerald-950';
					aiToggle.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-400 inline-block"></span> Enabled';
				} else {
					aiToggle.className = 'flex items-center gap-2 px-3 py-1.5 rounded-md border text-sm font-mono cursor-pointer transition-all bg-zinc-800/50 border-white/10 text-zinc-500 hover:bg-zinc-800';
					aiToggle.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-zinc-500 inline-block"></span> AI Hidden';
				}
				applyFilters();
			});

			nsSelect?.addEventListener('change', applyFilters);
			tierSelect?.addEventListener('change', applyFilters);

			// Tooltip: tap to toggle on mobile, hover handled by CSS
			const infoBtn = document.getElementById('ai-info-btn');
			const infoTooltip = document.getElementById('ai-info-tooltip');
			let tooltipOpen = false;

			infoBtn?.addEventListener('click', (e) => {
				e.stopPropagation();
				tooltipOpen = !tooltipOpen;
				if (tooltipOpen) {
					infoTooltip?.classList.remove('opacity-0', 'pointer-events-none');
					infoTooltip?.classList.add('opacity-100');
				} else {
					infoTooltip?.classList.add('opacity-0', 'pointer-events-none');
					infoTooltip?.classList.remove('opacity-100');
				}
			});

			document.addEventListener('click', () => {
				if (tooltipOpen) {
					tooltipOpen = false;
					infoTooltip?.classList.add('opacity-0', 'pointer-events-none');
					infoTooltip?.classList.remove('opacity-100');
				}
			});
		</script>
	</body>
</html>
