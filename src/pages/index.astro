---
import { getCollection } from 'astro:content';
import '../styles/global.css';

let posts = await getCollection('architectures');
posts = posts.filter(post => post.data.slug !== 'template');
posts.sort((a, b) => a.data.post - b.data.post);

const seriesMap = new Map<string, typeof posts>();

for (const post of posts) {
	const seriesName = post.data.namespace || 'uncategorized';
	const seriesPosts = seriesMap.get(seriesName) || [];
	seriesPosts.push(post);
	seriesMap.set(seriesName, seriesPosts);
}

const series = Array.from(seriesMap.entries())
	.map(([namespace, entries]) => ({
		namespace,
		title: namespace
			.split('-')
			.filter(part => part !== 'arch')
			.map(part => part.charAt(0).toUpperCase() + part.slice(1))
			.join(' '),
		posts: entries.sort((a, b) => a.data.post - b.data.post),
	}))
	.sort((a, b) => {
		const firstPostA = a.posts[0]?.data.post ?? 0;
		const firstPostB = b.posts[0]?.data.post ?? 0;
		return firstPostA - firstPostB;
	});

const totalPosts = posts.length;
const totalSeries = series.length;
const namespaces = [...new Set(posts.map(post => post.data.namespace))].filter(Boolean);
const tiers = [...new Set(posts.map(post => post.data.tier))].filter(Boolean).sort((a, b) => a - b);
const lastUpdated = posts.length > 0
	? new Date(Math.max(...posts.map(post => new Date(post.data.date).getTime()))).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
	: 'Never';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link href="https://api.fontshare.com/v2/css?f[]=satoshi@900,700,500,300,400&display=swap" rel="stylesheet">
		<title>Architecture Blog</title>
	</head>
	<body class="bg-[#000005] text-zinc-100 antialiased min-h-screen" style="font-family: 'Satoshi', system-ui, sans-serif;">
		<main class="max-w-4xl mx-auto px-5 sm:px-6 md:px-10 py-8 md:py-16 border-x border-white/10 min-h-screen">
			<article class="prose prose-invert prose-zinc max-w-none
				prose-headings:font-semibold
				prose-h1:text-3xl sm:prose-h1:text-4xl md:prose-h1:text-5xl prose-h1:border-b prose-h1:border-white/20 prose-h1:pb-3 prose-h1:mb-6
				prose-h2:text-xl sm:prose-h2:text-2xl prose-h2:border-b prose-h2:border-white/20 prose-h2:pb-2 prose-h2:mt-12 prose-h2:mb-4
				prose-h3:text-lg sm:prose-h3:text-xl
				prose-a:text-blue-400 prose-a:no-underline hover:prose-a:underline
				prose-code:bg-white/10 prose-code:rounded-md prose-code:py-[0.2rem] prose-code:px-[0.4rem] prose-code:font-mono prose-code:text-xs sm:prose-code:text-sm prose-code:font-normal prose-code:before:content-none prose-code:after:content-none">
				<header class="mb-10 border-b border-white/20 pb-8">
					<div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-zinc-500 font-mono text-xs sm:text-sm mb-5">
						<span>{totalPosts} posts</span>
						<span class="hidden sm:inline">/</span>
						<span>{totalSeries} series</span>
						<span class="hidden sm:inline">/</span>
						<span>Updated {lastUpdated}</span>
					</div>
					<h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white mb-4">Advaith's Blog</h1>
					<p class="text-zinc-300 text-base sm:text-lg leading-relaxed max-w-2xl">
						A running set of posts on a variety of topics.
					</p>
				</header>

				<section aria-labelledby="series-index">
					<h2 id="series-index">Series Index</h2>
					<details class="not-prose group mb-6 rounded-md border border-white/10 bg-[#0d1117] overflow-hidden">
						<summary class="flex cursor-pointer items-center justify-between px-4 py-2 hover:bg-white/[0.02] transition-colors list-none select-none [&::-webkit-details-marker]:hidden">
							<div class="flex items-center gap-3">
								<span class="font-mono text-zinc-300 font-bold text-xs">Filter posts</span>
								<span class="px-2 py-0.5 rounded-[4px] border border-white/10 text-[10px] text-zinc-400 bg-[#000005]">Series aware</span>
							</div>
							<div class="flex items-center gap-1 text-xs text-zinc-500 hover:text-zinc-300 transition-colors">
								<svg class="w-3 h-3 group-open:hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
								<svg class="w-3 h-3 hidden group-open:block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" /></svg>
								<span class="group-open:hidden">Show filters</span>
								<span class="hidden group-open:inline">Hide filters</span>
							</div>
						</summary>
						<div class="border-t border-white/10 p-4 bg-[#000005]">
							<div class="flex flex-col sm:flex-row gap-4">
								<div class="flex flex-col gap-1.5 w-full sm:w-auto">
									<label class="text-[10px] font-mono uppercase text-zinc-500 tracking-wider" for="filter-namespace">Series / Topic</label>
									<select id="filter-namespace" class="bg-[#0d1117] border border-white/10 rounded-md text-zinc-300 text-sm px-3 py-1.5 focus:border-white/20 focus:ring-1 focus:ring-white/20 outline-none cursor-pointer">
										<option value="all">Everything</option>
										{namespaces.map(namespace => <option value={namespace}>{namespace}</option>)}
									</select>
								</div>
								<div class="flex flex-col gap-1.5 w-full sm:w-auto">
									<label class="text-[10px] font-mono uppercase text-zinc-500 tracking-wider" for="filter-tier">System Complexity</label>
									<select id="filter-tier" class="bg-[#0d1117] border border-white/10 rounded-md text-zinc-300 text-sm px-3 py-1.5 focus:border-white/20 focus:ring-1 focus:ring-white/20 outline-none cursor-pointer">
										<option value="all">All Tiers</option>
										{tiers.map(tier => <option value={tier}>Tier {tier}</option>)}
									</select>
								</div>
								<div class="flex flex-col gap-1.5 w-full sm:w-auto">
									<label class="text-[10px] font-mono uppercase text-zinc-500 tracking-wider">AI Generated Posts</label>
									<button id="toggle-ai" data-active="true" class="flex items-center gap-2 px-3 py-1.5 rounded-md border text-sm font-mono cursor-pointer transition-all bg-emerald-950/50 border-emerald-500/30 text-emerald-400 hover:bg-emerald-950">
										<span class="w-1.5 h-1.5 rounded-full bg-emerald-400 inline-block"></span>
										Enabled
									</button>
								</div>
							</div>
						</div>
					</details>
					<div class="not-prose grid gap-3 sm:grid-cols-2">
						{series.map(group => (
							<a href={`#${group.namespace}`} class="series-index-card block rounded-lg border border-white/10 bg-white/[0.02] p-4 hover:border-white/25 hover:bg-white/[0.04] transition-colors" data-namespace={group.namespace}>
								<div class="flex items-start justify-between gap-3">
									<div>
										<h3 class="text-base font-bold text-white mb-1">{group.title}</h3>
										<p class="text-xs font-mono text-zinc-500">{group.namespace}</p>
									</div>
									<span class="shrink-0 rounded-md border border-white/10 bg-[#0d1117] px-2 py-1 text-xs font-mono text-zinc-400">
										{group.posts.length} {group.posts.length === 1 ? 'post' : 'posts'}
									</span>
								</div>
							</a>
						))}
					</div>
				</section>

				{series.map(group => (
					<section class="series-section" id={group.namespace} aria-labelledby={`${group.namespace}-heading`} data-namespace={group.namespace}>
						<h2 id={`${group.namespace}-heading`}>{group.title}</h2>
						<p class="text-zinc-400">
							Series namespace: <code>{group.namespace}</code>
						</p>
						<div class="not-prose space-y-4 mt-5">
							{group.posts.map(post => {
								const urlSlug = post.data.slug || post.id;
								const isAIPost = post.data.tags && post.data.tags.some((tag: string) => tag.toLowerCase() === 'ai');
								return (
									<article
										class="post-card rounded-lg border border-white/10 bg-white/[0.02] p-5 transition-colors hover:border-white/25 hover:bg-white/[0.04]"
										data-namespace={post.data.namespace || ''}
										data-tier={post.data.tier || ''}
										data-ai={isAIPost ? 'true' : 'false'}
									>
										<div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
											<div class="min-w-0">
												<div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-mono text-zinc-500 mb-2">
													<span>Post {post.data.post}</span>
													<span>/</span>
													<span>Tier {post.data.tier}</span>
													<span>/</span>
													<span>{post.data.date}</span>
												</div>
												<h3 class="text-lg sm:text-xl font-bold text-white mb-2">
													<a href={`/posts/${urlSlug}`} class="text-white hover:text-blue-300 hover:underline decoration-blue-300/40 underline-offset-4">
														{post.data.title}
													</a>
												</h3>
												<p class="text-sm leading-relaxed text-zinc-300">{post.data.description}</p>
												{post.data.tags && post.data.tags.length > 0 && (
													<div class="flex flex-wrap gap-2 mt-4">
														{post.data.tags.map((tag: string) => {
															const isAI = tag.toLowerCase() === 'ai';
															return (
																<span class={`rounded-md border px-2 py-0.5 text-[11px] font-mono font-medium ${isAI ? 'text-emerald-400 bg-emerald-950/50 border-emerald-500/30 shadow-[0_0_10px_rgba(16,185,129,0.2)]' : 'text-indigo-300 bg-indigo-950/40 border-indigo-500/20'}`}>
																	#{tag}
																</span>
															);
														})}
													</div>
												)}
											</div>
											<a href={`/posts/${urlSlug}`} class="inline-flex shrink-0 items-center self-start rounded-md border border-white/10 bg-[#0d1117] px-3 py-2 text-xs font-medium text-zinc-200 hover:border-white/25 hover:text-white transition-colors">
												Read post <span class="ml-1">→</span>
											</a>
										</div>
									</article>
								);
							})}
						</div>
					</section>
				))}

				{posts.length === 0 && <p class="text-zinc-500 italic">No architecture posts found yet.</p>}
			</article>

			<footer class="mt-24 pt-8 border-t border-white/10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 text-xs text-zinc-500">
				<div>
					<p class="font-medium text-zinc-400 mb-1">
						Built by <a href="https://glitchy.systems/" target="_blank" class="text-white hover:underline decoration-white/30 underline-offset-4 transition-all">Advaith Narayanan (Glitchy)</a>
					</p>
					<p class="font-mono text-[10px] uppercase tracking-wider text-zinc-600">Software Developer @ IBM • Systems Programming • Cloud Engineering</p>
				</div>
				<div class="flex gap-4 font-mono uppercase tracking-wider text-[10px]">
					<a href="https://github.com/Glitchyi" target="_blank" class="hover:text-white transition-colors">GitHub</a>
					<a href="https://twitter.com/advaithnarayan" target="_blank" class="hover:text-white transition-colors">Twitter</a>
					<a href="https://glitchy.systems/" target="_blank" class="hover:text-white transition-colors">Portfolio</a>
				</div>
			</footer>
		</main>

		<script>
			const nsSelect = document.getElementById('filter-namespace');
			const tierSelect = document.getElementById('filter-tier');
			const aiToggle = document.getElementById('toggle-ai');
			const cards = document.querySelectorAll('.post-card');
			const sections = document.querySelectorAll('.series-section');
			const indexCards = document.querySelectorAll('.series-index-card');
			let showAI = true;

			function applyFilters() {
				const selectedNs = (nsSelect as HTMLSelectElement)?.value || 'all';
				const selectedTier = (tierSelect as HTMLSelectElement)?.value || 'all';

				cards.forEach(card => {
					const matchesNs = selectedNs === 'all' || card.getAttribute('data-namespace') === selectedNs;
					const matchesTier = selectedTier === 'all' || card.getAttribute('data-tier') === selectedTier;
					const cardIsAI = card.getAttribute('data-ai') === 'true';
					const matchesAI = showAI || !cardIsAI;
					const isVisible = matchesNs && matchesTier && matchesAI;

					card.classList.toggle('hidden', !isVisible);
				});

				sections.forEach(section => {
					const hasVisibleCards = section.querySelectorAll('.post-card:not(.hidden)').length > 0;
					section.classList.toggle('hidden', !hasVisibleCards);
				});

				indexCards.forEach(indexCard => {
					const matchesNs = selectedNs === 'all' || indexCard.getAttribute('data-namespace') === selectedNs;
					indexCard.classList.toggle('hidden', !matchesNs);
				});
			}

			aiToggle?.addEventListener('click', () => {
				showAI = !showAI;
				if (showAI) {
					aiToggle.className = 'flex items-center gap-2 px-3 py-1.5 rounded-md border text-sm font-mono cursor-pointer transition-all bg-emerald-950/50 border-emerald-500/30 text-emerald-400 hover:bg-emerald-950';
					aiToggle.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-400 inline-block"></span> Enabled';
				} else {
					aiToggle.className = 'flex items-center gap-2 px-3 py-1.5 rounded-md border text-sm font-mono cursor-pointer transition-all bg-zinc-800/50 border-white/10 text-zinc-500 hover:bg-zinc-800';
					aiToggle.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-zinc-500 inline-block"></span> AI Hidden';
				}
				applyFilters();
			});

			nsSelect?.addEventListener('change', applyFilters);
			tierSelect?.addEventListener('change', applyFilters);
		</script>
	</body>
</html>
