---
import { getCollection, render } from 'astro:content';
import '../../styles/global.css';

export async function getStaticPaths() {
	const posts = await getCollection('architectures');
	return posts
		.filter(post => post.data.slug !== 'template')
		.filter(post => import.meta.env.DEV || post.data.complete !== false)
		.map(post => ({
			params: { id: post.data.slug || post.id },
			props: { post },
		}));
}

const { post } = Astro.props;
const { Content } = await render(post);
const isAIPost = post.data.tags && post.data.tags.some((t: string) => t.toLowerCase() === 'ai');
const allPosts = (await getCollection('architectures'))
	.filter(entry => entry.data.slug !== 'template')
	.filter(entry => import.meta.env.DEV || entry.data.complete !== false)
	.sort((a, b) => a.data.post - b.data.post);
const postIndex = allPosts.findIndex(entry => entry.id === post.id);
const previousPost = postIndex > 0 ? allPosts[postIndex - 1] : undefined;
const nextPost = postIndex < allPosts.length - 1 ? allPosts[postIndex + 1] : undefined;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link href="https://api.fontshare.com/v2/css?f[]=satoshi@900,700,500,300,400&display=swap" rel="stylesheet">
		<title>{post.data.title} - Advaith's Blog</title>
	</head>
	<body class="bg-[#000005] text-zinc-100 antialiased min-h-screen" style="font-family: 'Satoshi', system-ui, sans-serif;">
		<main class="max-w-4xl mx-auto px-5 sm:px-6 md:px-10 py-8 md:py-16 border-x border-white/10 min-h-screen">
			<a href="/" class="inline-flex items-center text-zinc-500 hover:text-white transition-colors mb-8 md:mb-12 font-medium">
				<span class="mr-2">←</span> Back to posts
			</a>

			<article class="prose prose-invert prose-zinc max-w-none 
			prose-headings:font-semibold 
			prose-h1:text-3xl sm:prose-h1:text-4xl prose-h1:border-b prose-h1:border-white/20 prose-h1:pb-3 prose-h1:mb-6
			prose-h2:text-xl sm:prose-h2:text-2xl prose-h2:border-b prose-h2:border-white/20 prose-h2:pb-2 prose-h2:mt-10 prose-h2:mb-4
			prose-h3:text-lg sm:prose-h3:text-xl
			prose-a:text-blue-400 prose-a:no-underline hover:prose-a:underline
			prose-pre:border prose-pre:border-white/20 prose-pre:bg-[#0d1117] prose-pre:rounded-xl prose-pre:p-5
			prose-code:bg-white/10 prose-code:rounded-md prose-code:py-[0.2rem] prose-code:px-[0.4rem] prose-code:font-mono prose-code:text-xs sm:prose-code:text-sm prose-code:font-normal prose-code:before:content-none prose-code:after:content-none
			[&_pre_code]:bg-transparent [&_pre_code]:p-0
			prose-blockquote:border-l-4 prose-blockquote:border-white/20 prose-blockquote:text-zinc-400 prose-blockquote:not-italic prose-blockquote:bg-white/[0.02] prose-blockquote:py-1 prose-blockquote:pr-4
			prose-table:border prose-table:border-white/20 prose-th:border prose-th:border-white/20 prose-th:p-3 prose-th:bg-white/[0.02] prose-td:border prose-td:border-white/20 prose-td:p-3
			">
				<header class="mb-8 md:mb-12 border-b border-white/20 pb-6 md:pb-8">
					<h1 class={`text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight mb-4 ${isAIPost ? 'text-emerald-50 drop-shadow-[0_0_12px_rgba(52,211,153,0.35)]' : 'text-white'}`}>{post.data.title}</h1>
					<div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-zinc-400 font-mono text-xs sm:text-sm">
						<span>{post.data.date}</span>
					</div>
					{post.data.tags && post.data.tags.length > 0 && (
						<div class="flex flex-wrap gap-2 mt-3">
							{post.data.tags.map((tag: string) => {
								const isAI = tag.toLowerCase() === 'ai';
								return (
									<span class={`font-mono font-medium text-[11px] px-2 py-0.5 rounded-md border transition-all ${isAI ? 'text-emerald-400 bg-emerald-950/50 border-emerald-500/30 shadow-[0_0_10px_rgba(16,185,129,0.2)]' : 'text-indigo-400 bg-indigo-950/40 border-indigo-500/20'}`}>
										#{tag}
									</span>
								);
							})}
						</div>
					)}
				</header>
				
				<div class="mt-8 text-sm sm:text-base text-zinc-300 leading-relaxed font-medium">
					<Content />
				</div>
			</article>

			<nav class="mt-14 grid gap-4 sm:grid-cols-2" aria-label="Post navigation">
				{previousPost ? (
					<a href={`/posts/${previousPost.data.slug || previousPost.id}`} class="rounded-lg border border-white/10 bg-white/[0.02] p-4 hover:border-white/25 hover:bg-white/[0.04] transition-colors">
						<div class="text-xs font-mono text-zinc-500 mb-2">Previous post</div>
						<div class="text-sm font-bold text-white">{previousPost.data.title}</div>
					</a>
				) : (
					<div class="rounded-lg border border-white/10 bg-white/[0.01] p-4 text-zinc-600">
						<div class="text-xs font-mono mb-2">Previous post</div>
						<div class="text-sm font-bold">First post</div>
					</div>
				)}
				{nextPost ? (
					<a href={`/posts/${nextPost.data.slug || nextPost.id}`} class="rounded-lg border border-white/10 bg-white/[0.02] p-4 text-right hover:border-white/25 hover:bg-white/[0.04] transition-colors">
						<div class="text-xs font-mono text-zinc-500 mb-2">Next post</div>
						<div class="text-sm font-bold text-white">{nextPost.data.title}</div>
					</a>
				) : (
					<div class="rounded-lg border border-white/10 bg-white/[0.01] p-4 text-right text-zinc-600">
						<div class="text-xs font-mono mb-2">Next post</div>
						<div class="text-sm font-bold">Latest post</div>
					</div>
				)}
			</nav>

			<footer class="mt-24 pt-8 border-t border-white/10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 text-xs text-zinc-500">
				<div>
					<p class="font-medium text-zinc-400 mb-1">
						Built by <a href="https://glitchy.systems/" target="_blank" class="text-white hover:underline decoration-white/30 underline-offset-4 transition-all">Advaith Narayanan (Glitchy)</a>
					</p>
					<p class="font-mono text-[10px] uppercase tracking-wider text-zinc-600">Software Developer @ IBM • Systems Programming • Cloud Engineering</p>
				</div>
				<div class="flex gap-4 font-mono uppercase tracking-wider text-[10px]">
					<a href="https://github.com/Glitchyi" target="_blank" class="hover:text-white transition-colors">GitHub</a>
					<a href="https://twitter.com/advaithnarayan" target="_blank" class="hover:text-white transition-colors">Twitter</a>
					<a href="https://glitchy.systems/" target="_blank" class="hover:text-white transition-colors">Portfolio</a>
				</div>
			</footer>
		</main>

		<script>
			document.querySelectorAll('pre').forEach((pre) => {
				// Style the pre block to allow absolute positioning of the button
				pre.classList.add('relative', 'group');

				const copyBtn = document.createElement('button');
				copyBtn.innerHTML = `
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
						<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
					</svg>`;
				copyBtn.className = 'absolute top-3 right-3 p-1.5 bg-white/5 hover:bg-white/10 text-zinc-500 hover:text-zinc-300 rounded-md border border-white/5 opacity-0 group-hover:opacity-100 transition-all cursor-pointer backdrop-blur-md z-10 flex items-center justify-center';
				copyBtn.setAttribute('title', 'Copy code');
				
				copyBtn.addEventListener('click', async () => {
					const codeBlock = pre.querySelector('code');
					if (!codeBlock) return;
					
					try {
						await navigator.clipboard.writeText(codeBlock.innerText);
						copyBtn.innerHTML = `
							<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<polyline points="20 6 9 17 4 12"></polyline>
							</svg>`;
						copyBtn.classList.add('bg-white/10', 'border-green-500/30');
						
						setTimeout(() => {
							copyBtn.innerHTML = `
								<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
									<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
								</svg>`;
							copyBtn.classList.remove('bg-white/10', 'border-green-500/30');
						}, 2000);
					} catch (err) {
						console.error('Failed to copy text: ', err);
					}
				});

				pre.appendChild(copyBtn);
			});
		</script>
	</body>
</html>
